const pool = require("../config/db");

const getAllContacts = async () => {
    const result = await pool.query('SELECT * FROM contacts ORDER BY "firstName" ')
    return result.rows;
};

const getContactById = async (id) => {
    const result = await pool.query('SELECT * FROM contacts WHERE id = $1',[id])
    return result.rows;
};

const createContact = async (contact) => {
    const {
        userId,
        firstName,
        middleName,
        lastName,
        email,
        phone,
        alternatePhone,
        website,
        address
    } = contact;

    const result = await pool.query(
        `INSERT INTO contacts
        (
            "userId",
            "firstName",
            "middleName",
            "lastName",
            email,
            phone,
            "alternatePhone",
            website,
            address
        )
        VALUES($1,$2,$3,$4,$5,$6,$7,$8,$9)
        RETURNING *`,
        [
            userId,
            firstName,
            middleName,
            lastName,
            email,
            phone,
            alternatePhone,
            website,
            address
        ]
    );

    return result.rows[0];
};

const updateContact = async (id, contact) => {

    const {
        firstName,
        middleName,
        lastName,
        email,
        phone,
        alternatePhone,
        website,
        address
    } = contact;

    const result = await pool.query(
        `UPDATE contacts
        SET
            "firstName" = $1,
            "middleName" = $2,
            "lastName" = $3,
            email = $4,
            phone = $5,
            "alternatePhone" = $6,
            website = $7,
            address = $8,
            "updatedAt" = CURRENT_TIMESTAMP
        WHERE id = $9
        RETURNING *`,
        [
            firstName,
            middleName,
            lastName,
            email,
            phone,
            alternatePhone,
            website,
            address,
            id
        ]
    );

    return result.rows[0];
};

const deleteContact = async (id) => {

    const result = await pool.query(
        "DELETE FROM contacts WHERE id = $1 RETURNING *",
        [id]
    );

    return result.rows[0];
};

module.exports = {
    getAllContacts,
    getContactById,
    createContact,
    updateContact,
    deleteContact
};